<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel name="general_panel" label="常规">
    <text name="language_textbox">语言：</text>
    <combo_box name="language_combobox">
        <combo_box.item label="英语" name="English" />
        <combo_box.item label="阿塞拜疆语" name="Azerbaijani" />
        <combo_box.item label="德语" name="Deutsch(German)" />
        <combo_box.item label="西班牙语" name="Spanish" />
        <combo_box.item label="法语" name="French" />
        <combo_box.item label="意大利语" name="Italian" />
        <combo_box.item label="波兰语" name="Polish" />
        <combo_box.item label="葡萄牙语" name="Portugese" />
        <combo_box.item label="俄语" name="Russian" />
        <combo_box.item label="土耳其语" name="Turkish" />
        <combo_box.item label="日语" name="(Japanese)" />
        <combo_box.item label="简体中文" name="Simplified Chinese" />
        <combo_box.item label="繁体中文" name="Traditional Chinese" />
    </combo_box>
    <text name="language_textbox2">（需要重新启动）</text>
    <text name="maturity_desired_prompt">允许访问的内容分级：</text>
    <combo_box name="maturity_desired_combobox">
        <combo_box.item label="普通、成人适度和成人" name="Desired_Adult" />
        <combo_box.item label="普通和成人适度" name="Desired_Mature" />
        <combo_box.item label="仅普通级" name="Desired_PG" />
    </combo_box>
    <check_box label="显示输入法编辑器（IME）" name="use_ime" tool_tip="使用国际输入法编辑器，仅在输入中文、日文等语言时需要。" />
    <text name="start_location_textbox">登录位置：</text>
    <combo_box name="start_location_combo">
        <combo_box.item label="上次所在位置" name="MyLastLocation" />
        <combo_box.item label="我的家" name="MyHome" />
    </combo_box>
    <check_box label="登录时显示位置" name="show_location_checkbox" />
    <text name="name_tags_textbox">姓名标签：</text>
    <radio_group name="Name_Tag_Preference">
        <radio_item label="关闭" name="radio" />
        <radio_item label="开启" name="radio2" />
        <radio_item label="简洁显示" name="radio3" />
    </radio_group>
    <check_box label="显示我的姓名" name="show_my_name_checkbox1" />
    <check_box label="显示用户名" name="show_slids" tool_tip="显示用户名，例如 bobsmith123。" />
    <combo_box name="group_title" tool_tip="设置群组头衔的显示方式。">
        <combo_box.item label="不显示群组头衔" name="no_tags" />
        <combo_box.item label="仅显示我的群组头衔" name="my_tag" />
        <combo_box.item label="显示所有群组头衔" name="all_tags" />
    </combo_box>
    <check_box label="显示群组头衔" name="show_all_title_checkbox1" />
    <check_box label="隐藏我的群组头衔" name="RenderHideGroupTitle" />
    <check_box label="显示名" name="display_names_check" />
    <check_box label="优先显示传统姓名，而不是用户名" name="FSshow_legacyun" />
    <check_box label="突出显示好友姓名" name="show_friends" />
    <check_box label="从姓名中隐藏“Resident”" name="legacy_trim_check" />
    <text name="time_format_textbox">时间格式：</text>
    <combo_box name="time_format_combobox">
        <combo_box.item label="下午 1:00" name="12H"/>
        <combo_box.item label="13:00" name="24H"/>
    </combo_box>
    <text name="time_format_textbox2">（需要重新启动）</text>
    <text name="title_afk_text">离开状态：</text>
    <text name="title_afk_quit_text">离开多久后断开连接：</text>
    <combo_box label="自动离开时间：" name="afk">
        <combo_box.item label="2 分钟" name="item0" />
        <combo_box.item label="5 分钟" name="item1" />
        <combo_box.item label="10 分钟" name="item2" />
        <combo_box.item label="30 分钟" name="item3" />
        <combo_box.item label="60 分钟" name="item4" />
        <combo_box.item label="从不" name="item5" />
    </combo_box>
    <check_box name="AvatarSitOnAway" label="进入离开状态时坐下" />
    <combo_box name="quitafk">
        <combo_box.item label="2 分钟" name="item0" />
        <combo_box.item label="5 分钟" name="item1" />
        <combo_box.item label="10 分钟" name="item2" />
        <combo_box.item label="30 分钟" name="item3" />
        <combo_box.item label="从不" name="item4" />
    </combo_box>
</panel>
