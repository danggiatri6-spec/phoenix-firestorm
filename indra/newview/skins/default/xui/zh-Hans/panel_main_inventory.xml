<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel label="库存" name="main inventory panel">
  <panel.string name="ItemcountFetching">正在获取库存（[ITEM_COUNT] 项... [FILTER]</panel.string>
  <panel.string name="ItemcountCompleted">[ITEM_COUNT] 项 [FILTER]</panel.string>
  <panel.string name="ItemcountUnknown">已获取 [ITEM_COUNT] 项 [FILTER]</panel.string>
  <panel.string name="inventory_title">库存</panel.string>
  <panel.string name="default_mode_btn">多文件夹模式</panel.string>
  <panel.string name="single_folder_mode_btn">单文件夹模式</panel.string>
  <layout_stack name="top_stack">
    <layout_panel name="nav_buttons">
      <button name="back_btn" tool_tip="后退" />
      <button name="forward_btn" tool_tip="前进" />
      <button name="up_btn" tool_tip="上一级" />
    </layout_panel>
    <layout_panel name="filter_panel">
      <filter_editor label="筛选库存" name="inventory search editor" tool_tip="输入一个或多个关键词进行搜索，多个关键词之间用“+”分隔" />
    </layout_panel>
  </layout_stack>
  <layout_stack name="ctrl_stack">
    <layout_panel name="collapse_expand_buttons">
      <button name="collapse_btn" label="折叠" />
      <button name="expand_btn" label="展开" />
    </layout_panel>
    <layout_panel name="filter_ctrls">
      <text name="filter_label" value="筛选：" />
      <combo_box name="filter_combo_box">
        <combo_box.item value="filter_type_all" label="全部类型" />
        <combo_box.item value="filter_type_animations" label="动画" />
        <combo_box.item value="filter_type_calling_cards" label="名片" />
        <combo_box.item value="filter_type_clothing" label="服装 / 身体部件" />
        <combo_box.item value="filter_type_gestures" label="手势" />
        <combo_box.item value="filter_type_landmarks" label="地标" />
        <combo_box.item value="filter_type_notecards" label="记事卡" />
        <combo_box.item value="filter_type_objects" label="物体" />
        <combo_box.item value="filter_type_scripts" label="脚本" />
        <combo_box.item value="filter_type_sounds" label="声音" />
        <combo_box.item value="filter_type_textures" label="纹理" />
        <combo_box.item value="filter_type_snapshots" label="快照" />
        <combo_box.item value="filter_type_materials" label="材质" />
        <combo_box.item value="filter_type_settings" label="环境设置" />
        <combo_box.item value="filter_type_folders" label="文件夹" />
        <combo_box.item value="filter_type_coalesced" label="仅显示合并对象" />
        <combo_box.item value="filter_type_custom" label="自定义..." />
      </combo_box>
      <menu_button name="options_visibility_btn" tool_tip="显示搜索结果可见性选项" />
    </layout_panel>
  </layout_stack>
  <panel name="default_inventory_panel">
    <tab_container name="inventory filter tabs">
      <inventory_panel label="全部项目" name="All Items" sort_order_setting="InventorySortOrder" />
      <recent_inventory_panel label="最近" sort_order_setting="RecentItemsSortOrder" name="Recent Items" />
      <worn_inventory_panel label="已穿戴" name="Worn Items" />
      <favorites_inventory_panel label="收藏夹" name="Favorites" />
    </tab_container>
  </panel>
  <panel name="bottom_panel">
    <panel name="options_gear_btn_panel">
      <menu_button tool_tip="显示其他选项" name="options_gear_btn" />
    </panel>
    <panel name="add_btn_panel">
      <button name="add_btn" tool_tip="添加新项目" />
    </panel>
    <panel name="new_inventory_panel">
      <button name="new_inv_btn" tool_tip="打开额外的库存窗口" />
    </panel>
    <panel name="show_filters_panel">
      <button name="show_filters_inv_btn" tool_tip="显示筛选器侧边栏。启用任何筛选条件后，此按钮会高亮显示。" />
    </panel>
    <panel name="view_mode_panel">
      <button name="view_mode_btn" tool_tip="切换视图模式" />
    </panel>
    <panel name="dummy_panel">
      <text name="ItemcountText" tool_tip="物体 [ITEMS]，文件夹 [CATEGORIES]">物体</text>
    </panel>
    <panel name="trash_btn_panel">
      <dnd_button name="trash_btn" tool_tip="删除选中的项目" />
    </panel>
  </panel>
</panel>
